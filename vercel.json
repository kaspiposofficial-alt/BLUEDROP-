{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...route].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/seo-robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo-sitemap"
    },
    {
      "source": "/((?!assets/|api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
